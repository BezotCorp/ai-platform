{
  "name": "@bezotcorp/bcaip-acp-client",
  "version": "1.53.0",
  "description": "TypeScript client library for BCAIP over Agent Client Protocol (ACP)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BezotCorp/ai-platform.git"
  },
  "keywords": [
    "bcaip",
    "ai",
    "agent",
    "acp",
    "agent-client-protocol"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run generate && pnpm run build:ts",
    "build:ts": "tsc",
    "generate": "tsx generate-schema.ts",
    "lint": "tsc --noEmit",
    "format": "prettier --write src/ generate-schema.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^1.5.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.6.0",
    "@kubb/cli": "^5.4.2",
    "@kubb/plugin-ts": "^5.0.2",
    "@kubb/plugin-zod": "^5.4.1",
    "@types/node": "^26.6.3",
    "kubb": "^5.4.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
