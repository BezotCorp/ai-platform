{
  "name": "vscode-bcaip",
  "displayName": "VS Code BCAIP",
  "description": "codename BCAIP for VSCode",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/block/vscode-bcaip"
  },
  "license": "Apache-2.0",
  "icon": "resources/bcaip-icon.png",
  "publisher": "block",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bcaip",
          "title": "BCAIP",
          "icon": "resources/bcaip-icon.svg"
        }
      ]
    },
    "views": {
      "bcaip": [
        {
          "icon": "./resources/bcaip-icon.png",
          "type": "webview",
          "id": "bcaip.chatView",
          "name": "BCAIP"
        }
      ]
    },
    "configuration": {
      "title": "BCAIP",
      "properties": {
        "bcaip.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the BCAIP binary. Leave empty for auto-detection."
        },
        "bcaip.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Logging level for the BCAIP extension."
        }
      }
    },
    "commands": [
      {
        "command": "bcaip.showLogs",
        "title": "BCAIP: Show Logs"
      },
      {
        "command": "bcaip.restart",
        "title": "BCAIP: Restart"
      },
      {
        "command": "bcaip.sendSelectionToChat",
        "title": "Send to BCAIP"
      }
    ],
    "keybindings": [
      {
        "command": "bcaip.sendSelectionToChat",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bcaip.sendSelectionToChat",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:extension && pnpm run build:webview && pnpm run build:webview:css",
    "build:extension": "pnpm exec esbuild ./src/extension/extension.ts --bundle --outdir=./dist --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --tsconfig=tsconfig.json",
    "build:webview": "pnpm exec esbuild ./src/webview/index.tsx --bundle --outdir=./dist/webview --entry-names=main --platform=browser --format=iife --minify --loader:.css=empty --tsconfig=tsconfig.webview.json",
    "build:webview:css": "pnpm exec tailwindcss -i ./src/webview/styles.css -o ./dist/webview/styles.css --minify",
    "dev": "pnpm exec esbuild ./src/extension/extension.ts --bundle --outdir=./dist --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --tsconfig=tsconfig.json --watch",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "lint": "pnpm exec biome lint",
    "lint:fix": "pnpm exec biome lint --write",
    "format": "pnpm exec biome format --write",
    "check": "pnpm exec biome check",
    "check:fix": "pnpm exec biome check --write",
    "ci": "pnpm exec biome ci",
    "package": "pnpm run build && pnpm exec vsce package --no-dependencies",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fp-ts": "^2.16.11",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
